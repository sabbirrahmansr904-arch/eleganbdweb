{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A single product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "fabric": { "type": "string" },
        "fitType": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "featured": { "type": "boolean" },
        "rating": { "type": "number" },
        "isTopRated": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "price", "category", "images", "sizes"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerInfo": { "type": "object" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["customerInfo", "items", "total", "status"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Homepage banner element",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "image": { "type": "string" },
        "title": { "type": "string" },
        "link": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["image", "active"]
    },
    "BrandingConfig": {
      "title": "BrandingConfig",
      "description": "Global settings for branding",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "sizeChartUrl": { "type": "string" },
        "collectionsBannerUrl": { "type": "string" },
        "heroBannerUrl": { "type": "string" },
        "featureBannerUrl": { "type": "string" },
        "categoryImages": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Admin configuration and privileges",
      "type": "object",
      "properties": {
        "role": { "type": "string" }
      }
    },
    "StockTransaction": {
      "title": "StockTransaction",
      "description": "Inventory movement record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "sku": { "type": "string" },
        "productName": { "type": "string" },
        "quantities": { "type": "object" },
        "totalQuantity": { "type": "number" },
        "timestamp": { "type": "number" },
        "category": { "type": "string" },
        "authorizedBy": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["type", "sku", "productName", "quantities", "totalQuantity", "timestamp", "category", "authorizedBy"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "slug"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review left by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["productId", "userName", "rating", "comment", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile and wishlist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "wishlist": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "email"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "A discount coupon / promo code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number" },
        "expiryDate": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "SmsLog": {
      "title": "SmsLog",
      "description": "A log of SMS sent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "sentAt": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["phone", "message", "status", "timestamp"]
    },
    "BankAccount": {
      "title": "BankAccount",
      "description": "A bank or mobile wallet account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bankName": { "type": "string" },
        "accountName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "branch": { "type": "string" },
        "initialBalance": { "type": "number" },
        "balance": { "type": "number" },
        "accountType": { "type": "string" }
      },
      "required": ["bankName", "accountName", "accountNumber", "balance"]
    },
    "BankTransaction": {
      "title": "BankTransaction",
      "description": "A financial transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "targetAccountId": { "type": "string" },
        "type": { "type": "string", "enum": ["deposit", "withdraw", "transfer"] },
        "amount": { "type": "number" },
        "date": { "type": "number" },
        "reference": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["accountId", "type", "amount", "date", "reference"]
    },
    "PathaoPayout": {
      "title": "PathaoPayout",
      "description": "Payout tracker from Pathao Courier to Bank Account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Paid"] },
        "reference": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["accountId", "amount", "date", "status"]
    },
    "DollarTransaction": {
      "title": "DollarTransaction",
      "description": "Records of buying or spending dollars",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["buy", "spend"] },
        "amount": { "type": "number" },
        "rate": { "type": "number" },
        "bdtAmount": { "type": "number" },
        "date": { "type": "number" },
        "purpose": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["type", "amount", "rate", "bdtAmount", "date"]
    }
  },
  "firestore": {
    "/dollar_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/DollarTransaction" },
      "description": "Stored dollar transactions (buy/spend) (admin only)"
    },
    "/bank_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/BankAccount" },
      "description": "Financial bank accounts"
    },
    "/bank_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/BankTransaction" },
      "description": "Financial transactions"
    },
    "/pathao_payouts/{payoutId}": {
      "schema": { "$ref": "#/entities/PathaoPayout" },
      "description": "Stored Pathao-to-Bank transfers (read/write admin)"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Stored products (read all, write admin)"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer Orders (create all, write/list admin, list own)"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Home page banners (read all, write admin)"
    },
    "/config/branding": {
      "schema": { "$ref": "#/entities/BrandingConfig" },
      "description": "App visual settings (read all, write admin)"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminConfig" },
      "description": "Admin records"
    },
    "/inventory_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/StockTransaction" },
      "description": "Inventory logs (admin only)"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories (read all, write admin)"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews (all read, all create)"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and wishlist (read own, write own)"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Discount coupons (read/list all, write admin)"
    },
    "/sms_logs/{logId}": {
      "schema": { "$ref": "#/entities/SmsLog" },
      "description": "Logs of sent SMS messages (create all, read/list admin)"
    }
  }
}
