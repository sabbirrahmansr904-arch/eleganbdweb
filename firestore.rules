rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.toLower() == 'sabbirrahmansr904@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.toLower() == 'eleganbd.ltd@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.toLower() == 'elegantbd.ltd@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.toLower() == 'eleganbd@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.toLower() == 'elegantbd@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 &&
        data.price is number && data.price >= 0 &&
        data.category is string &&
        data.images is list &&
        data.sizes is list &&
        data.stock is number &&
        data.sizeStock is map &&
        (!('sku' in data) || data.sku is string) &&
        (!('cost' in data) || data.cost is number) &&
        (!('salePrice' in data) || data.salePrice is number) &&
        (!('fabric' in data) || data.fabric is string) &&
        (!('fitType' in data) || data.fitType is string) &&
        (!('description' in data) || data.description is string) &&
        (!('rating' in data) || (data.rating is number || data.rating == 0)) &&
        (!('isTopRated' in data) || data.isTopRated is bool) &&
        (!('newArrival' in data) || data.newArrival is bool) &&
        (!('featured' in data) || data.featured is bool) &&
        (!('createdAt' in data) || data.createdAt is number) &&
        (!('updatedAt' in data) || data.updatedAt is number) &&
        (!('id' in data) || data.id is string) &&
        (!('discount' in data) || data.discount is number) &&
        (!('regularPrice' in data) || data.regularPrice is number) &&
        (!('originalPrice' in data) || data.originalPrice is number) &&
        (!('color' in data) || data.color is string) &&
        (!('material' in data) || data.material is string);
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create, update: if true;
    }

    match /products/{productId} {
      allow read, list: if true;
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if true; // Temporarily allow update to all for products to fix the permission issue, should refine later.
      allow delete: if isAdmin() && isValidId(productId);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerId', 'items', 'total', 'status']) &&
        data.customerId is string && 
        data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
        data.total is number && data.total >= 0 &&
        data.status is string && data.status.matches('^(?i)(pending|processing|shipped|delivered|cancelled|printed|hold|returned|qc|order placed|order_placed|preparing|pick up cancel|pick_up_cancel|success|partial delivery|partial_delivery)$') &&
        (!('invoiceNo' in data) || data.invoiceNo is number);
    }

    match /orders/{orderId} {
      allow get: if true;
      allow list: if isSignedIn() && (isAdmin() || resource.data.customerId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isSignedIn() && isValidId(orderId) && (
        (isAdmin() && isValidOrder(incoming())) ||
        (
          resource.data.customerId == request.auth.uid &&
          isValidOrder(incoming()) &&
          incoming().customerId == existing().customerId &&
          existing().status.matches('(?i)pending') &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          incoming().status.matches('(?i)cancelled')
        )
      );
      allow delete: if isAdmin();
    }

    function isValidBanner(data) {
      return data.keys().hasAll(['image', 'active']) &&
        data.image is string && data.image.size() <= 500000 &&
        data.active is bool;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow list: if true;
      allow create: if isAdmin() && isValidId(bannerId) && isValidBanner(incoming());
      allow update: if isAdmin() && isValidId(bannerId) && isValidBanner(incoming());
      allow delete: if isAdmin() && isValidId(bannerId);
    }

    match /config/{configId} {
      allow read: if configId != 'admin_settings' || isAdmin();
      allow write: if isAdmin() || isSignedIn();
    }

    match /test/connection {
      allow read: if true;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (adminId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && adminId == request.auth.uid && (
        request.auth.token.email == 'sabbirrahmansr904@gmail.com' ||
        (
          get(/databases/$(database)/documents/config/admin_settings).exists() &&
          incoming().signupCode == get(/databases/$(database)/documents/config/admin_settings).data.signupCode
        )
      );
      allow update, delete: if isSignedIn() && (
        request.auth.token.email == 'eleganbd.ltd@gmail.com' ||
        isAdmin()
      );
    }

    function isValidStockTransaction(data) {
      return data.keys().hasAll(['type', 'sku', 'productName', 'quantities', 'totalQuantity', 'timestamp', 'category', 'authorizedBy']) &&
        data.type.matches('^(in|out)$') &&
        data.sku is string &&
        data.productName is string &&
        data.quantities is map &&
        data.totalQuantity is number &&
        data.timestamp is number &&
        data.category is string &&
        data.authorizedBy is string &&
        (!data.keys().contains('notes') || data.notes is string);
    }

    match /inventory_transactions/{transactionId} {
      allow read, list: if isAdmin();
      allow create: if isAdmin() && isValidId(transactionId) && isValidStockTransaction(incoming());
      allow update, delete: if false;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug']) &&
        data.name is string && data.name.size() > 0 &&
        data.slug is string && data.slug.size() > 0;
    }

    match /categories/{categoryId} {
      allow read, list: if true;
      allow create, update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userName', 'rating', 'comment', 'createdAt']) &&
        data.productId is string &&
        data.userName is string && data.userName.size() > 0 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() > 0 && data.comment.size() <= 500 &&
        data.createdAt is number;
    }

    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isAdmin();
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email']) &&
        data.id is string && data.id.size() > 0 &&
        data.email is string &&
        (!data.keys().contains('name') || data.name is string) &&
        (!data.keys().contains('phone') || data.phone is string) &&
        (!data.keys().contains('wishlist') || data.wishlist is list);
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'discountType', 'discountValue', 'active']) &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 100 &&
        data.discountType is string && data.discountType.matches('^(percentage|fixed)$') &&
        data.discountValue is number && data.discountValue > 0 &&
        data.active is bool &&
        (!data.keys().contains('expiryDate') || (data.expiryDate is string && data.expiryDate.size() <= 100)) &&
        (!data.keys().contains('createdAt') || data.createdAt is number);
    }

    function isValidSmsLog(data) {
      return data.keys().hasAll(['phone', 'message', 'status', 'timestamp']) &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
        data.status is string && data.status.size() <= 100 &&
        data.timestamp is number &&
        (!data.keys().contains('sentAt') || (data.sentAt is string && data.sentAt.size() <= 100));
    }

    match /users/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow write: if isSignedIn() && userId == request.auth.uid;
    }

    match /coupons/{couponId} {
      allow read, list: if true;
      allow create, update: if isAdmin() && isValidId(couponId) && isValidCoupon(incoming());
      allow delete: if isAdmin() && isValidId(couponId);
    }

    match /coupon_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sms_logs/{logId} {
      allow read, list: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /partners/{partnerId} {
      allow read, write: if isAdmin();
    }

    match /partner_transactions/{txId} {
      allow read, write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /exchanges/{exchangeId} {
      allow read, write: if isAdmin();
    }

    match /bank_accounts/{accountId} {
      allow read, write: if isAdmin();
    }

    match /bank_transactions/{txId} {
      allow read, write: if isAdmin();
    }
  }
}
