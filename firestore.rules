rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == 'sabbirrahmansr904@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == 'eleganbd.ltd@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == 'shamiulislamatik@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == 'nasiruddinovi2025@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == 'elegantbd.ltd@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == 'eleganbd@gmail.com') ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.lower() == 'elegantbd@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$'); }

    // Customers collection
    match /customers/{customerId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(customerId);
    }

    // Products collection
    match /products/{productId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(productId);
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(orderId);
    }

    // Banners collection
    match /banners/{bannerId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(bannerId);
    }

    // Config collection (order counter, branding, theme, offers, sms_otp, admin settings, etc.)
    match /config/{configId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(configId);
    }

    // Branding collection
    match /branding/{brandingId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(brandingId);
    }

    // Test connection endpoint
    match /test/connection {
      allow read: if true;
    }

    // Admin management collections
    match /admins/{adminId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /admin_permissions/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /admin_invites/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    match /admin_profiles/{docId} {
      allow read, list: if true;
      allow create, update, delete: if true;
    }

    // Inventory transactions
    match /inventory_transactions/{transactionId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(transactionId);
    }

    // Categories
    match /categories/{categoryId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(categoryId);
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(reviewId);
    }

    // Users (customer accounts & profiles)
    match /users/{userId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // Coupons
    match /coupons/{couponId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(couponId);
    }

    // Coupon configs
    match /coupon_configs/{configId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(configId);
    }

    // SMS logs
    match /sms_logs/{logId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(logId);
    }

    // Partners & Finance
    match /partners/{partnerId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(partnerId);
    }

    match /partner_investments/{investmentId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(investmentId);
    }

    match /partner_transactions/{txId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(txId);
    }

    match /expenses/{expenseId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(expenseId);
    }

    match /exchanges/{exchangeId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(exchangeId);
    }

    match /bank_accounts/{accountId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(accountId);
    }

    match /bank_transactions/{txId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(txId);
    }

    match /pathao_payouts/{payoutId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(payoutId);
    }

    match /dollar_transactions/{transactionId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(transactionId);
    }

    match /invoice_by_options/{optionId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(optionId);
    }

    match /media/{mediaId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(mediaId);
    }

    // Live website visitors & analytics
    match /active_visitors/{visitorId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(visitorId);
    }

    match /site_analytics/{docId} {
      allow read, list: if true;
      allow create, update, delete: if isValidId(docId);
    }
  }
}
